{
  "name": "azd-extensions",
  "version": "1.0.0",
  "description": "A centralized registry and showcase site for azd extensions by Jon Gallant",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "validate-registry": "node scripts/validate-registry.js",
    "update-readme-versions": "node scripts/update-readme-versions.js"
  },
  "dependencies": {
    "@jongio/azd-web-core": "^2.4.1",
    "astro": "^6.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongio/azd-extensions.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "overrides": {
      "picomatch": ">=2.3.2",
      "lodash": ">=4.18.0",
      "fast-uri": ">=3.0.6"
    }
  },
  "author": "Jon Gallant",
  "license": "MIT"
}
