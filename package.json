{
  "name": "azd-extensions",
  "version": "1.0.0",
  "description": "A centralized registry and showcase site for azd extensions by Jon Gallant",
  "type": "module",
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "test": "vitest run",
    "validate-registry": "node scripts/validate-registry.js",
    "validate-schema": "node scripts/validate-schema.js",
    "generate-schema-v12": "node scripts/generate-v12-schema.js",
    "check-schema-v12": "node scripts/generate-v12-schema.js --check",
    "test-schema-v12": "vitest run schemas/v1.2/schema.test.js schemas/v1.2/promote-schema.test.js",
    "update-readme-versions": "node scripts/update-readme-versions.js"
  },
  "dependencies": {
    "@jongio/azd-web-core": "^3.0.1",
    "astro": "^7.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "yaml": "2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jongio/azd-extensions.git"
  },
