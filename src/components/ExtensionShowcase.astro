---
import type { Extension as Props } from '../types/extension';
import Icon from '@jongio/azd-web-core/components/Icon.astro';

const { id, name, tagline, description, icon, website, repository, features, scenarios, tags, glowColor } = Astro.props;
---

<div
  class="ext-card group relative overflow-hidden rounded-[var(--radius-lg)] border transition-[transform,box-shadow,border-color] duration-300"
  style={`border-color: var(--color-border); background-color: var(--color-surface); box-shadow: var(--shadow-card); --glow: ${glowColor};`}
>
  <!-- Hover glow -->
  <div
    class="pointer-events-none absolute -top-20 -right-20 h-60 w-60 rounded-full opacity-0 blur-[80px] transition-opacity duration-500 group-hover:opacity-20"
    style={`background-color: ${glowColor};`}
    aria-hidden="true"
  ></div>

  <div class="relative p-6 sm:p-8">
    <!-- Header: icon + title + tagline + links -->
    <div class="mb-6 flex items-start justify-between gap-4">
      <div class="flex items-start gap-4">
        <div
          class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl transition-transform duration-300 group-hover:scale-110"
          style={`background: linear-gradient(135deg, color-mix(in srgb, ${glowColor} 30%, transparent), color-mix(in srgb, ${glowColor} 10%, transparent)); color: ${glowColor};`}
        >
          <Icon name={icon} size={28} />
        </div>
        <div>
            <h3 class="text-xl font-bold sm:text-2xl" style="color: var(--color-text);">
              {name}
            </h3>
          <p class="mt-1 text-sm font-medium" style="color: var(--color-text-muted);">
            {tagline}
          </p>
        </div>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <a
          href={website}
          target="_blank"
          rel="noopener noreferrer"
          class="ext-link flex h-11 w-11 items-center justify-center rounded-lg transition-all"
          aria-label={`Visit ${name} website`}
          title="Website"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </a>
        <a
          href={repository}
          target="_blank"
          rel="noopener noreferrer"
          class="ext-link flex h-11 w-11 items-center justify-center rounded-lg transition-all"
          aria-label={`View ${name} on GitHub`}
          title="GitHub"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        </a>
      </div>
    </div>

    <!-- Description -->
    <p class="mb-6 text-sm leading-relaxed" style="color: var(--color-text-muted);">
      {description}
    </p>

    <!-- Features Grid -->
    {features.length > 0 && (
      <ul role="list" class="mb-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
        {features.map((feature) => (
          <li class="feature-item flex items-start gap-2 rounded-lg p-3">
            <span class="mt-0.5 shrink-0" style={`color: ${glowColor};`}>
              <Icon name={feature.icon} size={16} />
            </span>
            <div>
              <p class="text-xs font-semibold" style="color: var(--color-text);">{feature.title}</p>
              <p class="text-xs" style="color: var(--color-text-muted);">{feature.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    )}

    <!-- Try It Scenarios -->
    {scenarios.length > 0 && (
      <div class="mb-6">
        <h4 class="mb-3 text-xs font-semibold uppercase tracking-wider" style="color: var(--color-text-muted);">
          Try It
        </h4>
        <ol class="flex flex-col gap-2">
          {scenarios.map((scenario) => (
            <li>
              <p class="mb-1 text-xs" style="color: var(--color-text-muted);">{scenario.title}</p>
              <div class="terminal-code flex items-center gap-2 rounded-lg px-3 py-2">
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" style={`color: ${glowColor};`}><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
                <code class="terminal-code-inner flex-1 overflow-x-auto whitespace-nowrap text-xs" style="font-family: var(--azd-font-mono); color: var(--color-text);">
                  {scenario.command}
                </code>
                <button
                  class="copy-btn shrink-0 rounded flex items-center justify-center min-w-[44px] min-h-[44px] text-xs transition-colors"
                  aria-label={`Copy command: ${scenario.command}`}
                  data-command={scenario.command}
                >
                  <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                </button>
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    <!-- Tags -->
    {tags.length > 0 && (
      <ul role="list" class="flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <li
            class="rounded-md px-2 py-0.5 text-xs font-medium"
            style={`background-color: color-mix(in srgb, ${glowColor} 10%, transparent); color: ${glowColor}; border: 1px solid color-mix(in srgb, ${glowColor} 25%, transparent);`}
          >
            {tag}
          </li>
        ))}
      </ul>
    )}
  </div>
</div>

<!-- Screen reader announcement for copy actions (WCAG 4.1.3) -->
<div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>

<style>
  .ext-card:hover {
    transform: scale(1.01);
    box-shadow: 0 0 24px color-mix(in srgb, var(--glow) 15%, transparent),
                0 8px 32px color-mix(in srgb, var(--glow) 8%, transparent);
    border-color: color-mix(in srgb, var(--glow) 30%, var(--color-border));
  }

  .ext-link {
    color: var(--color-text-muted);
  }
  .ext-link:hover {
    color: var(--color-primary);
    background-color: color-mix(in srgb, var(--color-text) 5%, transparent);
    text-decoration: none;
  }

  .feature-item {
    background-color: color-mix(in srgb, var(--color-text) 4%, transparent);
  }

  .terminal-code {
    background-color: color-mix(in srgb, var(--color-text) 4%, transparent);
  }

  .terminal-code-inner {
    scrollbar-width: thin;
  }

  .copy-btn {
    color: var(--color-text-muted);
    background-color: transparent;
    border: none;
    cursor: pointer;
  }
  .copy-btn:hover {
    color: var(--color-text);
    background-color: color-mix(in srgb, var(--color-text) 8%, transparent);
  }

  /* Suppress card animations for reduced motion (WCAG 2.3.3) */
  @media (prefers-reduced-motion: reduce) {
    .ext-card:hover {
      transform: none;
    }
    .ext-card .pointer-events-none {
      transition: none;
      opacity: 0 !important;
    }
    .ext-card * {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  document.querySelectorAll('.copy-btn').forEach((btn) => {
    let copying = false;
    const originalHTML = btn.innerHTML;
    btn.addEventListener('click', async (e) => {
      if (copying) return;
      copying = true;
      e.stopPropagation();
      const command = (btn as HTMLElement).dataset.command || '';
      try {
        await navigator.clipboard.writeText(command);
        btn.innerHTML = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        const status = document.getElementById('copy-status');
        if (status) status.textContent = 'Command copied to clipboard';
        setTimeout(() => { if (status) status.textContent = ''; }, 2000);
      } catch {
        btn.innerHTML = '<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>';
        const status = document.getElementById('copy-status');
        if (status) status.textContent = 'Failed to copy command';
        setTimeout(() => { if (status) status.textContent = ''; }, 2000);
      }
      setTimeout(() => { btn.innerHTML = originalHTML; copying = false; }, 1500);
    });
  });
</script>
