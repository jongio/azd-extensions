---

<Layout
  title="azd extensions | Azure Developer CLI Extensions"
  description="Four powerful Azure Developer CLI extensions by Jon Gallant. azd app runs your entire app locally. azd copilot is your AI-powered Azure assistant. azd exec runs scripts with Azure credentials. azd rest makes authenticated REST API calls."
  extensionName="extensions"
  canonicalUrl="https://jongio.github.io/azd-extensions/"
  ogImage="https://jongio.github.io/azd-extensions/og-image.png"
>
  <Fragment slot="head">
    <meta name="keywords" content="Azure, Azure Developer CLI, azd, azd extensions, azd app, azd exec, azd copilot, azd rest, Azure CLI, developer tools, Jon Gallant, jongio, Azure authentication, local development, AI assistant, REST API" />
    <meta name="author" content="Jon Gallant" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" type="image/svg+xml" href="/azd-extensions/favicon.svg" />
    <link rel="icon" type="image/svg+xml" sizes="192x192" href="/azd-extensions/favicon-192.svg" />
    <link rel="apple-touch-icon" href="/azd-extensions/apple-touch-icon.svg" />
    <link rel="manifest" href="/azd-extensions/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "jongio/azd-extensions",
      "description": "Azure Developer CLI extensions by Jon Gallant — azd app for running apps locally, azd copilot for AI-powered Azure assistance, azd exec for script execution with Azure credentials, and azd rest for authenticated REST API calls",
      "applicationCategory": "DeveloperApplication",
      "operatingSystem": "Windows, macOS, Linux",
      "author": { "@type": "Person", "name": "Jon Gallant", "url": "https://github.com/jongio" },
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
      "url": "https://jongio.github.io/azd-extensions/",
      "downloadUrl": "https://github.com/jongio/azd-extensions"
    })} />
  </Fragment>

  <!-- Animated background glows -->
  <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
    <div class="animate-pulse-glow absolute -top-40 -left-40 h-80 w-80 rounded-full opacity-20 blur-[100px]" style="background-color: var(--color-glow-cyan);"></div>
    <div class="animate-pulse-glow absolute top-1/3 -right-40 h-96 w-96 rounded-full opacity-15 blur-[120px]" style="background-color: var(--color-glow-violet); animation-delay: 2s;"></div>
    <div class="animate-pulse-glow absolute -bottom-40 left-1/3 h-72 w-72 rounded-full opacity-10 blur-[100px]" style="background-color: var(--color-glow-emerald); animation-delay: 4s;"></div>
  </div>

  <!-- Custom Hub Header with personal branding -->
  <header
    class="sticky top-0 z-50 border-b backdrop-blur"
    style="background-color: color-mix(in srgb, var(--color-surface) 85%, transparent); border-color: var(--color-border);"
  >
    <div class="mx-auto flex max-w-[1280px] items-center justify-between px-[var(--space-6)] py-[var(--space-3)]">
      <div class="flex items-center gap-[var(--space-2)]">
        <a href="#" class="flex items-center gap-[var(--space-2)] no-underline" style="text-decoration:none;" aria-label="Home">
          <svg aria-hidden="true" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--color-primary);">
            <path d="M13.5 2L4 7.5V16.5L13.5 22L23 16.5V7.5L13.5 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M7 10L12 13L17 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 13V19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
        <span style="color: var(--color-text);">
          <strong>Azure Developer CLI Extensions</strong> by
          <a href="https://github.com/jongio" target="_blank" rel="noopener noreferrer" style="color: var(--color-primary); text-decoration: none;">Jon Gallant</a>
        </span>
      </div>
      <div class="flex items-center gap-[var(--space-2)]">
        <button
          id="hub-theme-toggle"
          class="flex h-11 w-11 items-center justify-center rounded-[var(--radius-md)] transition-colors"
          style="color: var(--color-text-muted);"
          aria-label="Toggle theme"
        >
          <svg aria-hidden="true" class="theme-icon-dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg aria-hidden="true" class="theme-icon-light" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        </button>
        <a
          href="https://x.com/jongallant"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-11 w-11 items-center justify-center rounded-[var(--radius-md)] transition-colors"
          style="color: var(--color-text-muted);"
          aria-label="Jon Gallant on X"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a
          href="https://www.linkedin.com/in/jongallant/"
          target="_blank"
          rel="noopener noreferrer"
          class="flex h-11 w-11 items-center justify-center rounded-[var(--radius-md)] transition-colors"
          style="color: var(--color-text-muted);"
          aria-label="Jon Gallant on LinkedIn"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
        </a>
        <a
          href="https://github.com/jongio"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-[var(--space-2)] rounded-[var(--radius-md)] px-3 py-1.5 text-sm font-medium transition-colors"
          style="color: var(--color-text-muted); border: 1px solid var(--color-border);"
          aria-label="Jon Gallant on GitHub"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
      </div>
    </div>
    <!-- Gradient accent line -->
    <div class="h-px" style="background: linear-gradient(90deg, var(--color-primary), var(--color-accent), var(--color-primary));" aria-hidden="true"></div>
  </header>

  <script>
    const toggle = document.getElementById('hub-theme-toggle');
    const darkIcon = toggle?.querySelector('.theme-icon-dark') as HTMLElement;
    const lightIcon = toggle?.querySelector('.theme-icon-light') as HTMLElement;
    function updateIcons() {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      if (darkIcon && lightIcon) {
        darkIcon.style.display = isDark ? 'block' : 'none';
        lightIcon.style.display = isDark ? 'none' : 'block';
      }
    }
    updateIcons();
    toggle?.addEventListener('click', () => {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('azd-theme', next);
      document.documentElement.style.colorScheme = next;
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', next === 'dark' ? '#0a0a0f' : '#fafafa');
      updateIcons();
    });
  </script>

  <main id="main-content" class="relative flex-1">
    <!-- Hero Section with sparkle badge and bold extension names -->
    <section class="relative overflow-hidden px-[var(--space-6)] py-[var(--space-20)] text-center">
      <div
        class="pointer-events-none absolute inset-0"
        style="background: radial-gradient(ellipse 60% 50% at 50% 40%, color-mix(in srgb, var(--color-primary) 8%, transparent), transparent);"
        aria-hidden="true"
      ></div>

      <div class="relative mx-auto max-w-3xl">
        <!-- Sparkle badge -->
        <a
          href="https://github.com/jongio"
          target="_blank"
          rel="noopener noreferrer"
          class="mb-[var(--space-8)] inline-flex items-center gap-2.5 rounded-full px-5 py-2 text-base font-medium transition-all"
          style="border: 1px solid color-mix(in srgb, var(--color-glow-cyan) 30%, transparent); background-color: color-mix(in srgb, var(--color-glow-cyan) 10%, transparent); color: var(--color-glow-cyan); text-decoration: none;"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-glow-cyan);"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          Azure Developer CLI Extensions by Jon Gallant
        </a>

        <h1
          class="mb-[var(--space-4)] font-bold leading-tight"
          style="font-size: var(--text-3xl);"
        >
          Supercharge your <span class="text-gradient-animated">Azure workflow</span>
        </h1>

        <p
          class="mx-auto mb-[var(--space-8)] max-w-2xl text-lg"
          style="color: var(--color-text-muted);"
        >
          <strong style="color: var(--color-text);">azd app</strong> runs your entire app locally.
          <strong style="color: var(--color-text);">azd copilot</strong> is your AI-powered Azure assistant.
          <strong style="color: var(--color-text);">azd exec</strong> runs scripts with Azure credentials.
          <strong style="color: var(--color-text);">azd rest</strong> makes authenticated REST API calls.
          Powerful extensions that transform your development experience.
        </p>

        <div class="flex flex-col items-center justify-center gap-[var(--space-4)] sm:flex-row">
          <a
            href="#extensions"
            class="inline-flex items-center gap-2 rounded-[var(--radius-md)] px-6 py-3 font-semibold transition-all hover:brightness-110"
            style="background: linear-gradient(135deg, var(--color-primary), var(--color-accent)); color: #ffffff !important; text-decoration: none;"
          >
            See the Extensions
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="#getting-started"
            class="inline-flex items-center gap-2 rounded-[var(--radius-md)] border px-6 py-3 font-semibold transition-all"
            style="border-color: var(--color-border); color: var(--color-text); text-decoration: none; background-color: color-mix(in srgb, var(--color-surface) 60%, transparent);"
          >
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
            Quick Start
          </a>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-[1280px] px-[var(--space-6)] py-[var(--space-12)]">
      <!-- Extensions Section -->
      <section id="extensions" class="scroll-mt-24">
        <div class="mb-[var(--space-12)] text-center">
          <h2 class="mb-[var(--space-4)]" style="font-size: var(--text-2xl);">
            The <span class="text-gradient">Extensions</span>
          </h2>
          <p style="color: var(--color-text-muted); font-size: var(--text-base);" class="mx-auto max-w-2xl">
            Built to solve real problems. Battle-tested with comprehensive security scanning,
            cross-platform support, and extensive documentation.
          </p>
        </div>

        <div class="mb-[var(--space-20)] grid gap-[var(--space-8)] md:grid-cols-2">
          {extensions.map((ext) => (
            <ExtensionShowcase
              id={ext.id}
              name={ext.name}
              tagline={ext.tagline}
              description={ext.description}
              icon={ext.icon}
              website={ext.website}
              repository={ext.repository}
              features={ext.features}
              scenarios={ext.scenarios}
              tags={ext.tags}
              glowColor={ext.glowColor}
            />
          ))}
        </div>
      </section>

      <!-- Getting Started Section -->
      <section id="getting-started" class="scroll-mt-24">
        <div
          class="relative overflow-hidden rounded-[var(--radius-lg)] border p-[var(--space-8)]"
          style="background-color: var(--color-surface); border-color: var(--color-border);"
        >
          <!-- Background glow -->
          <div class="pointer-events-none absolute -top-20 -right-20 h-60 w-60 rounded-full opacity-10 blur-[80px]" style="background-color: var(--color-glow-violet);" aria-hidden="true"></div>

          <div class="relative mx-auto max-w-3xl">
            <div class="mb-[var(--space-8)] text-center">
              <h2 class="mb-[var(--space-4)]" style="font-size: var(--text-2xl);">
                Get Started in <span class="text-gradient">30 Seconds</span>
              </h2>
              <p style="color: var(--color-text-muted);">
                Install Jon's extensions and supercharge your Azure workflow
              </p>
            </div>

            <div class="flex flex-col gap-[var(--space-8)]">
              <!-- Step 1: Install azd -->
              <StepCard
                number={1}
                title="Install Azure Developer CLI"
              />
              <div class="-mt-[var(--space-4)]">
                <InstallTabs tabs={installAzdTabs} />
              </div>

              <!-- Step 2: Add Extension Registry -->
              <StepCard
                number={2}
                title="Add Extension Registry"
                code="azd extension source add -n jongio -t url -l https://jongio.github.io/azd-extensions/registry.json"
              />

              <!-- Step 3: Install Extensions -->
              <StepCard
                number={3}
                title="Install Extensions"
                description="Install all extensions at once, or pick and choose."
              />
              <div class="-mt-[var(--space-4)] flex flex-col gap-[var(--space-3)]">
                <p class="text-sm font-semibold" style="color: var(--color-text-muted);">Install all</p>
                <CodeBlock code="azd extension install jongio.azd.app jongio.azd.copilot jongio.azd.exec jongio.azd.rest" />

                <div class="border-t pt-[var(--space-4)]" style="border-color: var(--color-border);">
                  <p class="mb-[var(--space-3)] text-sm font-semibold" style="color: var(--color-text-muted);">Or install individually</p>
                  <div class="flex flex-col gap-[var(--space-2)]">
                    <CodeBlock code="azd extension install jongio.azd.app" />
                    <CodeBlock code="azd extension install jongio.azd.copilot" />
                    <CodeBlock code="azd extension install jongio.azd.exec" />
                    <CodeBlock code="azd extension install jongio.azd.rest" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

