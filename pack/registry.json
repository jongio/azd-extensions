{
  "extensions": [
    {
      "id": "jongio.azd",
      "displayName": "Azure Developer CLI Extension Pack",
      "description": "Installs the jongio azd extensions, app, copilot and rest, in one step.",
      "tags": ["azd", "extension-pack"],
      "versions": [
        {
          "version": "0.1.0",
          "requiredAzdVersion": ">= 1.29.0",
          "usage": "azd extension install jongio.azd",
          "examples": [
            {
              "name": "install",
              "description": "Install every jongio azd extension in one step",
              "usage": "azd extension install jongio.azd"
            }
          ],
          "dependencies": [
            { "id": "jongio.azd.app", "version": ">= 0.20.0" },
            { "id": "jongio.azd.copilot", "version": ">= 0.2.4" },
            { "id": "jongio.azd.rest", "version": ">= 0.5.0" }
          ]
        }
      ]
    }
  ]
}
